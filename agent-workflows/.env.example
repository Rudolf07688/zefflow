# LLM provider — "gemini" (uses GOOGLE_API_KEY) or "vertex" (uses ADC + project/location)
LLM_PROVIDER=gemini

# Google AI Studio — Gemini API key (for LLM_PROVIDER=gemini)
GOOGLE_API_KEY=

# Vertex AI (for LLM_PROVIDER=vertex). Auth via `gcloud auth application-default login`.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Default model id (e.g. gemini-2.5-flash, gemini-2.5-pro)
DEFAULT_MODEL=gemini-2.5-flash

# DB connection — defaults to local SQLite for dev
DATABASE_URL=sqlite:///./dev.db

# Logging
LOG_LEVEL=INFO
